# ===== Applications =====
# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# ===== Auth =====
# Generate a value: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change-me-to-a-64-hex-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=480
AUTH_COOKIE_NAME=moneyball_session

# ===== Database (main) =====
# Postgres + pgvector via docker-compose
DATABASE_URL=postgresql+psycopg://moneyball:moneyball@localhost:54320/moneyball

# ===== Database (tests) =====
TEST_DATABASE_URL=postgresql+psycopg://moneyball:moneyball@localhost:54321/moneyball_test

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Embedding vector dimension (pgvector) =====
EMBEDDING_DIM=512

# ===== AI providers (optional, later phases) =====
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=rule_based

# ===== Demo seed scale =====
SEED_PLAYERS=5000
SEED_CLUBS=220
SEED_LEAGUES=18
SEED_SEASONS=5
SEED_UNIFORM_SEED=42

# ===== Real data (StatsBomb Open Data, optional) =====
# STATSBOMB_DATA_DIR=data/raw/statsbomb