{
  "name": "moneyball",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native football scouting & recruitment intelligence platform",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:web": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}